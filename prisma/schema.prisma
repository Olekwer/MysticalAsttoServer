// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователи
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String?
  firstName         String?
  lastName          String?
  birthDate         DateTime?
  birthTime         String?
  birthPlace        String?
  zodiacSign        ZodiacSign?
  element           Element?
  timezone          String   @default("UTC")
  language          String   @default("ru")
  isEmailVerified   Boolean  @default(false)
  isPremium         Boolean  @default(false)
  magicLinkToken    String?
  magicLinkExpires  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Связи
  profile           UserProfile?
  userRituals       UserRitual[]
  journalEntries    JournalEntry[]
  achievements      Achievement[]
  subscriptions     Subscription[]
  notifications     Notification[]
  energyScores     EnergyScore[]
  recommendations   Recommendation[]
  progress         Progress[]

  @@map("users")
}

// Профиль пользователя
model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  avatar      String?
  bio         String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Знаки зодиака
enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

// Элементы
enum Element {
  FIRE
  EARTH
  AIR
  WATER
}

// Ритуалы
model Ritual {
  id          String   @id @default(cuid())
  title       String
  description String?
  steps       Json
  duration    Int      // в минутах
  category    String
  difficulty  String
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  userRituals UserRitual[]
  tags        RitualTag[]

  @@map("rituals")
}

// Теги ритуалов
model RitualTag {
  id       String @id @default(cuid())
  name     String @unique
  color    String?
  rituals  Ritual[]

  @@map("ritual_tags")
}

// Пользовательские ритуалы
model UserRitual {
  id        String   @id @default(cuid())
  userId    String
  ritualId  String
  status    RitualStatus @default(ACTIVE)
  progress  Int      @default(0)
  startedAt DateTime @default(now())
  completedAt DateTime?
  notes     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ritual    Ritual   @relation(fields: [ritualId], references: [id], onDelete: Cascade)

  @@unique([userId, ritualId])
  @@map("user_rituals")
}

enum RitualStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// Лунные фазы
model MoonPhase {
  id          String   @id @default(cuid())
  date        DateTime @unique
  phase       MoonPhaseType
  illumination Float
  moonrise    DateTime?
  moonset     DateTime?
  createdAt   DateTime @default(now())

  @@map("moon_phases")
}

enum MoonPhaseType {
  NEW_MOON
  WAXING_CRESCENT
  FIRST_QUARTER
  WAXING_GIBBOUS
  FULL_MOON
  WANING_GIBBOUS
  LAST_QUARTER
  WANING_CRESCENT
}

// Энергетические показатели
model EnergyScore {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  score     Float
  factors   Json
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("energy_scores")
}

// Рекомендации
model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  type        RecommendationType
  content     Json
  priority    Int      @default(1)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@map("recommendations")
}

enum RecommendationType {
  RITUAL_OF_DAY
  STONE_OF_DAY
  TEA_RECIPE
  ENERGY_TIP
  ASTROLOGICAL_PATH
}

// Дневник
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  mood      String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

// Достижения
model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  icon        String?
  unlockedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

// Прогресс
model Progress {
  id        String   @id @default(cuid())
  userId    String
  type      String
  value     Int
  date      DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, date])
  @@map("progress")
}

// Подписки
model Subscription {
  id            String   @id @default(cuid())
  userId        String
  plan          String
  status        SubscriptionStatus
  startDate     DateTime
  endDate       DateTime?
  stripeId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

// Уведомления
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  scheduledAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Камни
model Stone {
  id          String   @id @default(cuid())
  name        String
  description String?
  properties  Json
  zodiacSigns ZodiacSign[]
  elements    Element[]
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stones")
}

// Рецепты настоев
model TeaRecipe {
  id          String   @id @default(cuid())
  name        String
  description String?
  ingredients Json
  instructions String
  benefits    String[]
  zodiacSigns ZodiacSign[]
  elements    Element[]
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tea_recipes")
} 