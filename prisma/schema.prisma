generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String?
  firstName        String?
  lastName         String?
  birthDate        DateTime?
  birthTime        String?
  birthPlace       String?
  zodiacSign       ZodiacSign?
  element          Element?
  timezone         String           @default("UTC")
  language         String           @default("ru")
  isEmailVerified  Boolean          @default(false)
  isPremium        Boolean          @default(false)
  magicLinkToken   String?
  magicLinkExpires DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  achievements     Achievement[]
  energyScores     EnergyScore[]
  journalEntries   JournalEntry[]
  notifications    Notification[]
  progress         Progress[]
  recommendations  Recommendation[]
  subscriptions    Subscription[]
  profile          UserProfile?
  userRituals      UserRitual[]
  userPowerPlaces  UserPowerPlace[]

  @@map("users")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  avatar      String?
  bio         String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Ritual {
  id                String              @id @default(cuid())
  title             String
  description       String?
  steps             Json
  duration          Int
  category          String
  difficulty        String
  audioUrl          String?
  locationId        String?
  isPremium         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  RitualToRitualTag RitualToRitualTag[]
  userRituals       UserRitual[]
  location          PowerPlace?         @relation(fields: [locationId], references: [id])

  @@map("rituals")
}

model RitualTag {
  id                String              @id @default(cuid())
  name              String              @unique
  color             String?
  RitualToRitualTag RitualToRitualTag[]

  @@map("ritual_tags")
}

model UserRitual {
  id          String       @id @default(cuid())
  userId      String
  ritualId    String
  status      RitualStatus @default(ACTIVE)
  progress    Int          @default(0)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  notes       String?
  ritual      Ritual       @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ritualId])
  @@map("user_rituals")
}

model MoonPhase {
  id           String        @id @default(cuid())
  date         DateTime      @unique
  phase        MoonPhaseType
  illumination Float
  moonrise     DateTime?
  moonset      DateTime?
  createdAt    DateTime      @default(now())

  @@map("moon_phases")
}

model EnergyScore {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  score     Float
  factors   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("energy_scores")
}

model Recommendation {
  id        String             @id @default(cuid())
  userId    String
  date      DateTime
  type      RecommendationType
  content   Json
  priority  Int                @default(1)
  isRead    Boolean            @default(false)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@map("recommendations")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  mood      String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  icon        String?
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  type      String
  value     Int
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, date])
  @@map("progress")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      String
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?
  stripeId  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Stone {
  id          String       @id @default(cuid())
  name        String
  description String?
  properties  Json
  zodiacSigns ZodiacSign[]
  elements    Element[]
  isPremium   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("stones")
}

model TeaRecipe {
  id           String       @id @default(cuid())
  name         String
  description  String?
  ingredients  Json
  instructions String
  benefits     String[]
  zodiacSigns  ZodiacSign[]
  elements     Element[]
  isPremium    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("tea_recipes")
}

model RitualToRitualTag {
  A           String
  B           String
  rituals     Ritual    @relation(fields: [A], references: [id], onDelete: Cascade)
  ritual_tags RitualTag @relation(fields: [B], references: [id], onDelete: Cascade)

  @@unique([A, B], map: "_RitualToRitualTag_AB_unique")
  @@index([B], map: "_RitualToRitualTag_B_index")
  @@map("_RitualToRitualTag")
}

enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum Element {
  FIRE
  EARTH
  AIR
  WATER
}

enum RitualStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MoonPhaseType {
  NEW_MOON
  WAXING_CRESCENT
  FIRST_QUARTER
  WAXING_GIBBOUS
  FULL_MOON
  WANING_GIBBOUS
  LAST_QUARTER
  WANING_CRESCENT
}

enum RecommendationType {
  RITUAL_OF_DAY
  STONE_OF_DAY
  TEA_RECIPE
  ENERGY_TIP
  ASTROLOGICAL_PATH
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

model PowerPlace {
  id          String   @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  type        String   @default("mystical") // mystical, natural, historical, etc.
  energyLevel Int      @default(5) // 1-10 scale
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userPlaces  UserPowerPlace[]
  rituals     Ritual[]

  @@map("power_places")
}

model UserPowerPlace {
  id           String     @id @default(cuid())
  userId       String
  powerPlaceId String
  distance     Float      // Distance in kilometers
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  powerPlace   PowerPlace @relation(fields: [powerPlaceId], references: [id], onDelete: Cascade)

  @@unique([userId, powerPlaceId])
  @@map("user_power_places")
}
