# Application
APP_PORT=3010
NODE_ENV=production

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/mystical_astro?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS - разрешенные домены (через запятую)
# Для продакшена добавьте ваши реальные домены
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Email (если используется)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# RabbitMQ (если используется)
RABBITMQ_URL=amqp://localhost:5672

# Storage (если используется)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
